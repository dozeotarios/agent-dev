{
  "name": "@agent-dev/agentdev",
  "version": "1.3.5",
  "description": "Hierarchical agent orchestration on herdr \u2014 a pi extension (the brain) driving herdr (the body).",
  "private": false,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi",
    "pi-extension",
    "herdr",
    "agents",
    "orchestration"
  ],
  "pi": {
    "extensions": [
      "./pi/extensions/agentdev/index.ts"
    ],
    "skills": [
      "./pi/skills"
    ]
  },
  "files": [
    "bin",
    "pi",
    "ARCHITECTURE.md",
    "DEVELOPMENT.md",
    "README.md",
    "specs",
    "setup.sh",
    "setup.ps1"
  ],
  "scripts": {
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:unit": "node node_modules/vitest/vitest.mjs run tests/unit",
    "test:integration": "node node_modules/vitest/vitest.mjs run tests/integration",
    "test:e2e": "node node_modules/vitest/vitest.mjs run tests/e2e",
    "test:evals": "node node_modules/vitest/vitest.mjs run tests/evals",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "prepublishOnly": "npm test && npm run typecheck",
    "verify": "npm run typecheck && npm test",
    "test:cli": "node node_modules/vitest/vitest.mjs run tests/cli"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agentdev": "./bin/agentdev-install.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
